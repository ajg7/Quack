# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — your real key never gets committed.

# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Only needed for identity-linked keys, which must name the workspace each
# request acts in. Find it at console.anthropic.com/settings/workspaces —
# open the workspace and copy the id (wrkspc_...) from the URL.
# ANTHROPIC_WORKSPACE_ID=wrkspc_...

# Internal integration secret from https://www.notion.so/my-integrations
# The token grants NO access on its own — you must also connect your database
# to the integration inside Notion (database ••• menu → Connections).
NOTION_API_KEY=ntn_...
